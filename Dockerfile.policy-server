# syntax=docker/dockerfile:1

FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS builder

ARG TARGETARCH # provided by docker buildkit

# Install build dependencies for Rust and C libraries
RUN apk add --no-cache \
    curl \
    build-base \
    musl-dev \
    pkgconfig

# Download rustup-init, verify checksum, and install Rust
RUN <<EOF
  case "${TARGETARCH}" in \
    amd64)
      RUST_TARGET="x86_64-unknown-linux-musl"
      CHECKSUM="9cd3fda5fd293890e36ab271af6a786ee22084b5f6c2b83fd8323cec6f0992c1"
      ;;
    arm64)
      RUST_TARGET="aarch64-unknown-linux-musl"
      CHECKSUM="88761caacddb92cd79b0b1f939f3990ba1997d701a38b3e8dd6746a562f2a759"
      ;;
    *)
      echo "Unsupported architecture: ${TARGETARCH}" && exit 1
      ;;
  esac

  curl --proto '=https' --tlsv1.2 --output rustup-init -sSf \
    "https://static.rust-lang.org/rustup/archive/1.29.0/${RUST_TARGET}/rustup-init"
  echo "${CHECKSUM} *./rustup-init" | sha256sum -c - || exit 1

  chmod +x ./rustup-init
  ./rustup-init -y --default-toolchain stable --profile minimal --target "${RUST_TARGET}"
  rm ./rustup-init

  echo "${RUST_TARGET}" > /tmp/rust_target
EOF

ENV PATH=/root/.cargo/bin:$PATH

# Install cargo-auditable. It does not need the workspace files, so this step
# stays here, before the COPY commands. A change to a crate then does not
# invalidate this layer. The two mounts hold the cargo download cache. The
# cache stays on the build machine. It does not go into the image.
RUN --mount=type=cache,id=cargo-registry,target=/root/.cargo/registry \
    --mount=type=cache,id=cargo-git,target=/root/.cargo/git \
    cargo install --locked --version 0.7.4 cargo-auditable

WORKDIR /usr/src/policy-server

# Copy workspace files
COPY ./Cargo.toml ./Cargo.lock ./
COPY crates/ ./crates

# Enable static linking after cargo-audit is installed,
# apparetnly it cannot be statically linked.
ENV RUSTFLAGS="-C target-feature=+crt-static"

# Build the policy-server binary statically linked.
# The cargo-target mount holds the compiled dependencies between builds, so a
# change to one crate does not force a rebuild of the full dependency tree.
# A docker build with this cache stores it on the build machine only, not in
# the image, so you must copy the binary out before the mount closes.
# Run "docker builder prune" to clear this cache.
RUN --mount=type=cache,id=cargo-registry,target=/root/.cargo/registry \
    --mount=type=cache,id=cargo-git,target=/root/.cargo/git \
    --mount=type=cache,id=cargo-target-${TARGETARCH},target=/usr/src/policy-server/target \
    cargo auditable build --release -p policy-server --target $(cat /tmp/rust_target) && \
    cp target/$(cat /tmp/rust_target)/release/policy-server /policy-server

# Verify the binary is statically linked
RUN ldd /policy-server || echo "Static binary confirmed"

# Create minimal user configuration
FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS cfg

RUN echo "policy-server:x:65533:65533::/tmp:/sbin/nologin" >> /etc/passwd && \
    echo "policy-server:x:65533:policy-server" >> /etc/group

# Final stage with distroless image
FROM gcr.io/distroless/static:nonroot
COPY --from=builder /policy-server /policy-server
COPY --from=cfg /etc/passwd /etc/passwd
COPY --from=cfg /etc/group /etc/group
COPY ./Cargo.lock /Cargo.lock

USER 65533:65533

# Default port, should be used when tls is not enabled
EXPOSE 3000
# Readiness probe port, always http
EXPOSE 8081
# To be used when tls is enabled
EXPOSE 8443

ENTRYPOINT ["/policy-server"]
