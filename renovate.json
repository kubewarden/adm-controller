{
  "extends": [
    "github>kubewarden/github-actions//renovate-config/default"
  ],
  "ignoreDeps": [
    "sigs.k8s.io/wg-policy-prototypes"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pinned tool versions and their checksums annotated with renovate directives",
      "managerFilePatterns": [
        "/(^|/)\\.github/.+\\.ya?ml$/",
        "/(^|/)scripts/.+\\.sh$/",
        "/(^|/)Makefile$/",
        "/(^|/)Dockerfile\\.[^/]+$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?(?: versioning=(?<versioning>\\S+))?\\s*\\n\\s*(?:ARG\\s+|ENV\\s+)?\\S+?\\s*(?::?=|:)\\s*\"?(?<currentValue>[^\"\\s]+)\"?",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) digestVersion=(?<currentValue>\\S+)\\s*\\n\\s*\\S+?\\s*(?::?=|:)\\s*\"?(?<currentDigest>[^\"\\s]+)\"?"
      ]
    },
    {
      "customType": "regex",
      "description": "Update policy modules and kuberlr-kubectl image in values.yaml. The registry is global.cattle.systemDefaultRegistry",
      "managerFilePatterns": [
        "/^charts/admission-controller/values\\.yaml$/"
      ],
      "matchStrings": [
        "repository: \"(?<depName>(?:kubewarden/policies|rancher)/[^\"]+)\"\\n\\s+tag: (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "ghcr.io/{{{depName}}}",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update policy modules and kuberlr-kubectl image in the hauler_manifest.yaml and in artifacthub.io/images annotation",
      "managerFilePatterns": [
        "/^charts/hauler_manifest\\.yaml$/",
        "/^charts/admission-controller/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "(?:- name|image): (?<depName>ghcr\\.io/(?:kubewarden/policies|rancher)/[^:\\s]+):(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update openreports Helm chart in hauler_manifest.yaml",
      "managerFilePatterns": [
        "/^charts/hauler_manifest\\.yaml$/"
      ],
      "matchStrings": [
        "- name: (?<depName>openreports)\\n\\s+version: (?<currentValue>\\S+)\\n\\s+repoURL: (?<registryUrl>\\S+)"
      ],
      "datasourceTemplate": "helm"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false
  },
  "packageRules": [
    {
      "description": "helm-values looks up the images on DockerHub, but the chart pulls them from global.cattle.systemDefaultRegistry. A custom manager updates the third-party images, and the release updates the Kubewarden images",
      "matchManagers": [
        "helm-values"
      ],
      "matchFileNames": [
        "charts/admission-controller/values.yaml"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "k8s.io/client-go"
      ],
      "allowedVersions": "/^0\\.[0-9]+\\.[0-9]+$/"
    },
    {
      "matchPackageNames": [
        "github.com/google/cel-go"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDatasources": [
        "go"
      ],
      "groupName": "Go dependencies"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "Rust dependencies"
    },
    {
      "description": "Update all opentelemetry packages together",
      "groupName": "Rust opentelemetry packages",
      "matchPackageNames": [
        "opentelemetry",
        "opentelemetry-otlp",
        "opentelemetry_sdk",
        "tracing-opentelemetry"
      ]
    },
    {
      "description": "Update all jemalloc packages together",
      "groupName": "Rust jemalloc packages",
      "matchPackageNames": [
        "tikv-jemalloc-ctl",
        "jemalloc_pprof"
      ]
    },
    {
      "description": "Update all wasmtime packages together",
      "groupName": "Rust wasmtime packages",
      "matchPackageNames": [
        "wasmtime",
        "wasmtime-wasi"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "!golang-version"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "!golang-version"
      ],
      "groupName": "Custom manager updates"
    },
    {
      "description": "Update the Makefile pin and the CI action of golangci-lint together",
      "groupName": "golangci-lint",
      "matchPackageNames": [
        "golangci/golangci-lint"
      ]
    },
    {
      "description": "Update the Makefile pin and the CI action of typos together",
      "groupName": "typos",
      "matchPackageNames": [
        "crate-ci/typos"
      ]
    },
    {
      "matchManagers": [
        "helm-values",
        "helmfile",
        "helm-chart",
        "helmv3"
      ],
      "matchPackageNames": [
        "policy-reporter"
      ],
      "matchDatasources": [
        "helm"
      ],
      "enabled": false
    },
    {
      "description": "Renovate updates Chart.lock with openreports, and updatecli updates it with policy-reporter",
      "matchManagers": [
        "helmv3"
      ],
      "lockFileMaintenance": {
        "enabled": false
      }
    },
    {
      "description": "Update Helm chart dependencies in one PR. updatecli updates policy-reporter. Renovate reads postUpdateOptions from the first upgrade of the branch, thus helmUpdateSubChartArchives must apply to the whole group to update the vendored openreports archive in charts/.",
      "matchPackageNames": [
        "ghcr.io/kubewarden/policies/**",
        "ghcr.io/rancher/kuberlr-kubectl",
        "openreports"
      ],
      "groupName": "Helm chart dependencies",
      "postUpdateOptions": [
        "helmUpdateSubChartArchives"
      ],
      "reviewers": [
        "team:kubewarden-developers"
      ],
      "prBodyNotes": [
        "## Update Checklist\n- [ ] I have checked that the admission-controller values `recommendedPolicies.*.settings` are up to date\n- [ ] I have updated charts/admission-controller/questions.yaml from those of the policies"
      ]
    },
    {
      "description": "ghcr.io gives no release timestamps, thus a minimumReleaseAge above 0 keeps the image updates pending forever",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/kubewarden/policies/**",
        "ghcr.io/rancher/kuberlr-kubectl"
      ],
      "minimumReleaseAge": "0 days"
    }
  ]
}
