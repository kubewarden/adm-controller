{
  "extends": [
    "github>kubewarden/github-actions//renovate-config/default"
  ],
  "ignoreDeps": [
    "sigs.k8s.io/wg-policy-prototypes"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pinned tool versions and their checksums annotated with renovate directives",
      "managerFilePatterns": [
        "/(^|/)\\.github/.+\\.ya?ml$/",
        "/(^|/)scripts/.+\\.sh$/",
        "/(^|/)Makefile$/",
        "/(^|/)Dockerfile\\.[^/]+$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?(?: versioning=(?<versioning>\\S+))?\\s*\\n\\s*(?:ARG\\s+|ENV\\s+)?\\S+?\\s*(?::?=|:)\\s*\"?(?<currentValue>[^\"\\s]+)\"?",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) digestVersion=(?<currentValue>\\S+)\\s*\\n\\s*\\S+?\\s*(?::?=|:)\\s*\"?(?<currentDigest>[^\"\\s]+)\"?"
      ]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false
  },
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "kubewarden/adm-controller/controller",
        "kubewarden/adm-controller/audit-scanner"
      ],
      "matchFileNames": [
        "charts/admission-controller/values.yaml"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "kubewarden/adm-controller/policy-server"
      ],
      "matchFileNames": [
        "charts/kubewarden-defaults/values.yaml"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "k8s.io/client-go"
      ],
      "allowedVersions": "/^0\\.[0-9]+\\.[0-9]+$/"
    },
    {
      "matchPackageNames": [
        "github.com/google/cel-go"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDatasources": [
        "go"
      ],
      "groupName": "Go dependencies"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "Rust dependencies"
    },
    {
      "description": "Update all opentelemetry packages together",
      "groupName": "Rust opentelemetry packages",
      "matchPackageNames": [
        "opentelemetry",
        "opentelemetry-otlp",
        "opentelemetry_sdk",
        "tracing-opentelemetry"
      ]
    },
    {
      "description": "Update all jemalloc packages together",
      "groupName": "Rust jemalloc packages",
      "matchPackageNames": [
        "tikv-jemalloc-ctl",
        "jemalloc_pprof"
      ]
    },
    {
      "description": "Update all wasmtime packages together",
      "groupName": "Rust wasmtime packages",
      "matchPackageNames": [
        "wasmtime",
        "wasmtime-wasi"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "!golang-version"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "!golang-version"
      ],
      "groupName": "Custom manager updates"
    },
    {
      "description": "Update the Makefile pin and the CI action of golangci-lint together",
      "groupName": "golangci-lint",
      "matchPackageNames": [
        "golangci/golangci-lint"
      ]
    },
    {
      "description": "Update the Makefile pin and the CI action of typos together",
      "groupName": "typos",
      "matchPackageNames": [
        "crate-ci/typos"
      ]
    },
    {
      "matchManagers": [
        "helm-values",
        "helmfile",
        "helm-chart",
        "helmv3"
      ],
      "matchPackageNames": [
        "policy-reporter"
      ],
      "matchDatasources": [
        "helm"
      ],
      "enabled": false
    },
    {
      "description": "updatecli updates Chart.lock together with the Hauler manifest",
      "matchManagers": [
        "helmv3"
      ],
      "lockFileMaintenance": {
        "enabled": false
      }
    },
    {
      "description": "updatecli updates the kuberlr-kubectl image together with the Hauler manifest",
      "matchPackageNames": [
        "rancher/kuberlr-kubectl",
        "ghcr.io/rancher/kuberlr-kubectl"
      ],
      "enabled": false
    }
  ]
}
