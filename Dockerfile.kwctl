# syntax=docker/dockerfile:1
#
# Build the statically linked kwctl binary for Linux, natively on musl.
#
# This image is not meant to run. Its only output is the binary, which is
# the sole content of the last stage. Export it with:
#
#   docker build -f Dockerfile.kwctl --output type=local,dest=out .
#
# The build uses the architecture of the machine that runs it, and writes
# out/kwctl. The binary embeds its list of dependencies with cargo-auditable.
#
# Keep the builder stage in sync with Dockerfile.policy-server.

FROM alpine:3.24.4@sha256:93b41ef40b1677fce8fcc64ff4af09daddfacf5040afde618bc46c1e2d1cc7d4 AS builder

ARG TARGETARCH # provided by docker buildkit

# The version of cargo-auditable that embeds the list of dependencies in the
# binary. Renovate updates it.
# renovate: datasource=github-releases depName=rust-secure-code/cargo-auditable extractVersion=^v(?<version>.*)$
ARG CARGO_AUDITABLE_VERSION=0.7.7

# Install build dependencies for Rust and C libraries. rustup comes from the
# Alpine package repository, whose packages are signed. This image does not
# download an installer, so there is no installer checksum to keep up to date.
RUN apk add --no-cache \
    build-base \
    musl-dev \
    pkgconfig \
    rustup

RUN <<EOF
  case "${TARGETARCH}" in
    amd64)
      RUST_TARGET="x86_64-unknown-linux-musl"
      ;;
    arm64)
      RUST_TARGET="aarch64-unknown-linux-musl"
      ;;
    *)
      echo "Unsupported architecture: ${TARGETARCH}" && exit 1
      ;;
  esac

  # Install rustup only, without any toolchain. The toolchain is installed
  # further down from rust-toolchain.toml, so that the image builds with the
  # Rust version that the repository pins. A default toolchain here would be
  # a second one, that nothing uses.
  rustup-init -y --default-toolchain none --profile minimal

  echo "${RUST_TARGET}" > /tmp/rust_target
EOF

ENV PATH=/root/.cargo/bin:$PATH

WORKDIR /usr/src/kwctl

# Install the Rust toolchain that the repository pins: the version, the
# components and the targets all come from rust-toolchain.toml. The file
# changes only on a Rust update, so this layer stays cached.
COPY ./rust-toolchain.toml ./
RUN rustup toolchain install

# Install cargo-auditable. It does not need the workspace files, so this step
# stays here, before the COPY commands. A change to a crate then does not
# invalidate this layer. The two mounts hold the cargo download cache. The
# cache stays on the build machine. It does not go into the image.
RUN --mount=type=cache,id=cargo-registry,target=/root/.cargo/registry \
    --mount=type=cache,id=cargo-git,target=/root/.cargo/git \
    cargo install --locked --version "${CARGO_AUDITABLE_VERSION}" cargo-auditable

# Copy workspace files
COPY ./Cargo.toml ./Cargo.lock ./
COPY crates/ ./crates

# Enable static linking after cargo-auditable is installed,
# apparently it cannot be statically linked.
ENV RUSTFLAGS="-C target-feature=+crt-static"

# Build the kwctl binary statically linked.
# The cargo-target mount holds the compiled dependencies between builds, so a
# change to one crate does not force a rebuild of the full dependency tree.
# It stays on the build machine and not in the image, so the binary is copied
# out before the mount closes.
RUN --mount=type=cache,id=cargo-registry,target=/root/.cargo/registry \
    --mount=type=cache,id=cargo-git,target=/root/.cargo/git \
    --mount=type=cache,id=cargo-target-kwctl-${TARGETARCH},target=/usr/src/kwctl/target,sharing=locked \
    cargo auditable build --locked --release -p kwctl --target $(cat /tmp/rust_target) && \
    cp target/$(cat /tmp/rust_target)/release/kwctl /kwctl

# Verify the binary is statically linked
RUN ldd /kwctl || echo "Static binary confirmed"

# The binary is the only thing that leaves the build
FROM scratch
COPY --from=builder /kwctl /kwctl
